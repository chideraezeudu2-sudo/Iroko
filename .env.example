# ---- Groq (backend) ----
# GROQ_API_KEY: Required for Groq AI API calls (server-side only).
# Get a key at https://console.groq.com/keys. Groq hosts ultra-fast Llama models
# via an OpenAI-compatible endpoint.
GROQ_API_KEY="MY_GROQ_API_KEY"

# ---- Supabase ----
# Public project URL and anon key — safe to expose to the browser (VITE_* prefix
# makes them available to the Vite frontend bundle).
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-side Supabase keys (used by server.ts to verify JWTs and persist rows).
# The SERVICE ROLE key bypasses RLS — keep it server-side only, never commit.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# ---- App URL ----
# The URL where this app is hosted (used for OAuth redirect + API base).
APP_URL="MY_APP_URL"
PORT=3000

# VITE_API_URL: optional explicit backend origin for split deployments
# (frontend on Vercel, backend on Render). Leave empty for same-origin /api/*.
VITE_API_URL=""

